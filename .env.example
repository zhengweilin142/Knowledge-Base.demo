# 把本文件复制为 .env 后填写；页面「设置」里保存也会自动写入 .env。
# .env 已在 .gitignore 中，不会被提交。

# ---------- 大模型（用于生成回答）----------
# 留空则只做检索、不生成回答（页面上会提示未配置），方便先验证数据链路
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500

# ---------- 检索 ----------
KB_VECTOR_TOPK=20
KB_BM25_TOPK=20
KB_FINAL_TOPK=5
KB_RERANK_CANDIDATES=20

# ---------- 相关性闸门 ----------
# 重排器可用时，最终判据是 KB_RERANK_MIN_SCORE（实测安全区 0.0~0.5）
# 重排器不可用时，退回余弦门槛 KB_MIN_RELEVANCE（注意：此模式下存在漏拦，见 README 第四节）
KB_MIN_RELEVANCE=0.40
KB_BM25_MIN_VECTOR=0.55

# ---------- 重排（Cross-Encoder）----------
# 关闭后仅用余弦门槛，精度会下降（README 第四节有实测对比）
KB_RERANK=1
KB_RERANK_MODEL=BAAI/bge-reranker-base
KB_RERANK_MIN_SCORE=0.5
KB_RERANK_COSINE_FLOOR=0.25

# ---------- 切分 ----------
KB_CHUNK_SIZE=500
KB_CHUNK_OVERLAP=80
KB_MIN_CHUNK=40

# ---------- 向量模型（fastembed / ONNX）----------
# 可选：BAAI/bge-small-zh-v1.5（默认，512维，约90MB）
#       jinaai/jina-embeddings-v2-base-zh（更大，效果更好）
KB_EMBED_MODEL=BAAI/bge-small-zh-v1.5
# 查询侧指令前缀。fastembed 的 Qdrant 转换版权重已内置，保持留空；
# 若换成官方 BAAI 权重再填「为这个句子生成表示以用于检索相关文章：」
KB_QUERY_PREFIX=

# 模型下载镜像（内网/受限网络填私有镜像，如 https://hf-mirror.com）
# HF_ENDPOINT=https://hf-mirror.com

# ---------- 服务 ----------
KB_HOST=127.0.0.1
KB_PORT=8000
